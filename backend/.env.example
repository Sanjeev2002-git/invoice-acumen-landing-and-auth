# Copy to .env (or set as real env vars / application-local.properties) and fill in.
# Never commit the real values.

DB_URL=jdbc:mysql://localhost:3306/invoice_acumen?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Brevo (or any SMTP) credentials - required for forgot-password emails and notifications.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-your-brevo-login
MAIL_PASSWORD=replace-with-your-brevo-smtp-key
ADMIN_EMAIL=replace-with-your-admin-email@example.com
